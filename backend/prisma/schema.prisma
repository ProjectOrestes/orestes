generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Producto {
  id           Int      @id @default(autoincrement())
  nombre       String
  descripcion  String?
  precio       Decimal  @db.Decimal(10,2)
  stock        Int
  stockMinimo  Int      @default(0)
  activo       Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

